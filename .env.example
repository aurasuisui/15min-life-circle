# ==============================================================================
# 「15 分钟生活圈」智能体检与规划助手 —— 环境变量模板
#
# 用法：
#   cp .env.example .env        # Linux/macOS
#   Copy-Item .env.example .env # Windows PowerShell
#   然后在 .env 里填入你自己的密钥（.env 已被 .gitignore 忽略，绝不会入库）
#
# ⚠️ 密钥红线：
#   * 仓库里【只有】本文件，且所有值都是占位符。
#   * BAIDU_MAP_SERVER_AK / BAIDU_MAP_SERVER_SK / LLM_API_KEY 绝不能提交，也不能写进任何 VITE_ 变量。
#   * 前端只能拿到「浏览器端」类型的 VITE_BAIDU_MAP_BROWSER_AK，并需在控制台配置 Referer 白名单。
#   * 文档 / 截图 / 日志里的密钥一律脱敏成 ak=**** 、sk=**** 。
#
# 变量清单与 docs/CONTRACT.md §2 对齐（字段名已冻结，请勿改名）。
# ==============================================================================

# ------------------------------------------------------------------ 百度地图
# 浏览器端 AK（JSAPI）：仅用于前端地图渲染。
#   申请时「应用类型」必须选【浏览器端】，并配置 Referer 白名单（开发期可填 localhost:5173*）。
VITE_BAIDU_MAP_BROWSER_AK=<你的浏览器端AK>

# 服务端 AK（Web 服务 API）：仅后端使用，绝不可出现在前端代码/变量中。
#   需勾选：地理编码 / 地点检索 / 批量算路 / 步行路线规划(轻量) / 坐标转换
BAIDU_MAP_SERVER_AK=<你的服务端AK>

# 服务端 SK：AK 的校验方式选【SN 签名】时生成，用于服务端计算 sn。
#   ⚠️ 不要选「IP 白名单」——那样评审方换台机器就会直接 status=210 失败。
BAIDU_MAP_SERVER_SK=<你的服务端SK>

# ------------------------------------------------------------------ LLM（可选，全部可留空）
# 留空或 LLM_ENABLED=false 时，报告走【模板化降级】，功能不缺失（ai_report.degraded=true）。
# 协议为 OpenAI 兼容，DeepSeek / Qwen / GLM 均可。
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=<你的LLM API Key，可留空>
LLM_MODEL=deepseek-chat
LLM_EFFORT=low
# 网络出口在香港（代理）时延迟偏高，超时请勿小于 20 秒。
LLM_TIMEOUT_S=40
LLM_MAX_TOKENS=4000

# ------------------------------------------------------------------ 运行模式
# live   = 全部走真实百度 API（消耗配额）
# replay = 只读 data/seed 快照，【零 API 配额】，评审方开箱可跑（推荐默认）
# hybrid = 缓存优先 → 未命中走 live → 配额熔断后回落 seed 快照
DATA_MODE=replay

# ------------------------------------------------------------------ 后端服务
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------------ 配额保护
# 官方个人开发者上限 3 QPS，这里刻意留约 17% 余量，请勿调到 3.0。
API_QPS_LIMIT=2.5
# 地点检索每日配额（瓶颈所在，个人开发者实测 100/日）
API_DAILY_POI_LIMIT=100
# 批量算路每日配额。注意：计费按【最终路线数】而不是请求数（1×50 打包仍计 50）。
API_DAILY_ROUTE_LIMIT=5000

# ------------------------------------------------------------------ 缓存与离线回放
CACHE_DB_PATH=./data/cache/app.db
# 兼容开关：为 true 且 DATA_MODE 未显式指定时，按 replay 行为启动。
ENABLE_OFFLINE_REPLAY=true
